<Window x:Class="OOP_Project_Part2_WPF_CS.AddActivities"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOP_Project_Part2_WPF_CS"
        mc:Ignorable="d"
        Title="AddActivities" Height="700" Width="800">
    <Grid>
        <Button x:Name="btnMainMenu" Content="Go Back" HorizontalAlignment="Left" Margin="44,130,0,0" VerticalAlignment="Top" Click="btnMainMenu_Click" FontSize="22" RenderTransformOrigin="0.152,0.392" Width="101"/>
        <Button x:Name="btnReset" Content="Reset" HorizontalAlignment="Left" Margin="214,130,0,0" VerticalAlignment="Top" Click="btnReset_Click" FontSize="22" RenderTransformOrigin="0.533,0.302"/>
        <Label x:Name="lblDateTime" Content="Date and Time" HorizontalAlignment="Left" Margin="44,200,0,0" VerticalAlignment="Top" FontSize="22" Width="160"/>
        <Label x:Name="lblTitle" Content="Title" HorizontalAlignment="Left" Margin="43,255,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.078,0.48" FontSize="22"/>
        <Label x:Name="lblCost" Content="Cost" HorizontalAlignment="Left" Margin="44,315,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.493,-0.723" FontSize="22"/>
        <TextBox x:Name="txtDateStartTime" HorizontalAlignment="Left" Margin="467,200,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="288" Height="30" FontSize="22"/>
        <TextBox x:Name="txtTitle" HorizontalAlignment="Left" Margin="467,260,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="288" Height="30" FontSize="22"/>
        <TextBox x:Name="txtCost" HorizontalAlignment="Left" Margin="467,315,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="288" Height="30" FontSize="22"/>
        <TabControl Margin="44,400,45,15">
            <TabItem Header="Entertainment" FontSize="22">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="86*"/>
                        <ColumnDefinition Width="147*"/>
                        <ColumnDefinition Width="349*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="lblMinParticipants" Content="MinParticipants" HorizontalAlignment="Left" Margin="144,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.237,-2.828" Grid.Column="3" Grid.ColumnSpan="2" FontSize="22"/>
                    <TextBox x:Name="txtMinParticipants" HorizontalAlignment="Left" Margin="90,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="270" Grid.Column="3" Grid.ColumnSpan="2" Height="35" RenderTransformOrigin="0.475,1.52" FontSize="22"/>
                    <Button x:Name="btnSaveEntertainmentActivity" Content="Save Entertainment Activity" HorizontalAlignment="Left" Margin="90,140,0,0" VerticalAlignment="Top" Grid.Column="3" Click="btnSaveEntertainmentActivity_Click" Grid.ColumnSpan="2" FontSize="22" Width="270"/>
                </Grid>
            </TabItem>
            <TabItem Header="Fitness" FontSize="22">
                <Grid Background="#FFE5E5E5" Margin="0,0,-1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="9*"/>
                        <ColumnDefinition Width="49*"/>
                        <ColumnDefinition Width="303*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="lblLocation" Content="Location" HorizontalAlignment="Left" Margin="192,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.237,-2.828" Grid.Column="3" FontSize="22"/>
                    <TextBox x:Name="txtLocation" HorizontalAlignment="Left" Margin="102,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="270" Grid.Column="3" Height="35" RenderTransformOrigin="0.475,1.52" FontSize="22"/>
                    <Button x:Name="btnSaveFitnessActivity" Grid.Column="3" Content="Save Fitness Activity" HorizontalAlignment="Left" Margin="103,140,0,0"  VerticalAlignment="Top" Click="btnSaveFitnessActivity_Click"  FontSize="22" Width="270"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Label x:Name="lblDateTimeFormat" Content="DD/MM/YYYY HH:MM" HorizontalAlignment="Left" Margin="497,130,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.079,-0.499" FontSize="22"/>
        <Label x:Name="lblAddActivities" Content="Add Activities" HorizontalAlignment="Center" Margin="0,40,0,0" VerticalAlignment="Top" FontSize="22"/>
    </Grid>
</Window>
