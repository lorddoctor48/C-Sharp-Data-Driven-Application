<Window x:Class="OOP_Project_Part2_WPF_CS.DeleteActivities"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOP_Project_Part2_WPF_CS"
        mc:Ignorable="d"
        Title="DeleteActivities" Height="700" Width="800">
    <Grid>
        <Label x:Name="lblDeleteActivities" Content="Delete Activities" HorizontalAlignment="Center" Margin="0,40,0,0" VerticalAlignment="Top" FontSize="22"/>
        <TabControl Margin="40,100,40,40">
            <TabItem Header="Entertainment" FontSize="22" HorizontalAlignment="Left" Margin="-2,-2,0,0" Width="153">
                <Grid Background="#FFE5E5E5" Height="500">

                    <Label x:Name="lblDateTimeFormat" Content="DD/MM/YYYY HH:MM" HorizontalAlignment="Left" Margin="436,20,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.079,-0.499" FontSize="22"/>
                    <Label x:Name="lblDateTime" Content="Date and Time" HorizontalAlignment="Left" Margin="20,80,0,0" VerticalAlignment="Top" FontSize="22" Width="160"/>
                    <TextBox x:Name="txtEntertainmentDateStartTime" HorizontalAlignment="Right" Margin="0,80,20,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="288" Height="30" FontSize="22" Grid.Column="1"/>
                    <DataGrid x:Name="dgEntertainmentActivities" AutoGenerateColumns="False" FontSize="22" Margin="20,141,20,100" Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date/StartTime" Binding="{Binding DateStartTime}" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" />
                            <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" />
                            <DataGridTextColumn Header="MinParticipants" Binding="{Binding MinParticipants}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="btnDeleteEntertainmentActivity" Content="Delete Entertainment Activity" HorizontalAlignment="Center" Margin="0,440,0,0" VerticalAlignment="Top" Click="btnDeleteEntertainmentActivity_Click"/>
                    <Button x:Name="btnDisplayAllEntertainmentActivities" Content="Display Entertainment " HorizontalAlignment="Left" Margin="16,26,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.599,0.511" FontSize="22" Grid.ColumnSpan="2" Click="btnDisplayAllEntertainmentActivities_Click"/>
                    <Button x:Name="btnClearEntertainmentTable" Content="Clear Table" Margin="276,26,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.426,-0.179" HorizontalAlignment="Left" FontSize="22" Click="btnClearEntertainmentTable_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="Fitness" FontSize="22" Height="33" VerticalAlignment="Top">
                <Grid Background="#FFE5E5E5" Height="500">
                    <Label x:Name="lblDateTimeFormat_Copy" Content="DD/MM/YYYY HH:MM" HorizontalAlignment="Left" Margin="436,20,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.079,-0.499" FontSize="22"/>
                    <Label x:Name="lblDateTime_Copy" Content="Date and Time" HorizontalAlignment="Left" Margin="20,80,0,0" VerticalAlignment="Top" FontSize="22" Width="160"/>
                    <TextBox x:Name="txtFitnessDateStartTime" HorizontalAlignment="Right" Margin="0,80,20,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="288" Height="30" FontSize="22"/>
                    <Button x:Name="btnDisplayAllFitnessActivities" Content="Display Fitness " HorizontalAlignment="Left" Margin="16,26,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.599,0.511" FontSize="22" Click="btnDisplayAllFitnessActivities_Click"/>
                    <Button x:Name="btnClearFitnessTable" Content="Clear Table" Margin="248,26,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.426,-0.179" HorizontalAlignment="Left" FontSize="22" Click="btnClearFitnessTable_Click" />
                    <DataGrid x:Name="dgFitnessActivities" AutoGenerateColumns="False" FontSize="22" Margin="20,141,20,100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date/StartTime" Binding="{Binding DateStartTime}" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" />
                            <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="btnDeleteFitnessActivity" Content="Delete Fitness Activity" HorizontalAlignment="Center" Margin="0,440,0,0" VerticalAlignment="Top" Click="btnDeleteFitnessActivity_Click"/>

                </Grid>
            </TabItem>
        </TabControl>
        <Button x:Name="btnGoBack" Content="Go Back" HorizontalAlignment="Left" Margin="40,43,0,0" VerticalAlignment="Top" FontSize="22" RenderTransformOrigin="0.5,0.813" Click="btnGoBack_Click"/>

    </Grid>
</Window>
